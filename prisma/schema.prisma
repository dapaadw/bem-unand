generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERUSER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]
}

model Contacts {
  id           Int      @id @default(1)
  whatsappUrl  String?
  instagramUrl String?
  email        String?
  updatedAt    DateTime @updatedAt
}

model Publikasi {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  publishedAt    DateTime
  author         String
  category       String
  body           String
  attachmentUrl  String?
  imageUrl       String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([category, publishedAt(sort: Desc)])
}

enum KegiatanType {
  LOMBA
  INTERNAL
}

model Kegiatan {
  id               String       @id @default(cuid())
  type             KegiatanType
  name             String
  slug             String       @unique
  date             DateTime
  time             String?
  publishedAt      DateTime     @default(now())
  location         String
  organizer        String
  description      String
  publicationUrl   String?
  registrationUrl  String?
  imageUrl         String?
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([type, date(sort: Desc)])
  @@index([date(sort: Asc)])
  @@index([publishedAt(sort: Desc)])
}

model Departemen {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  photoUrl    String?
  description String?

  staff    DepartemenStaff[]
  proker   ProgramKerja[]
}

model DepartemenStaff {
  id            String     @id @default(cuid())
  departemenId  String
  departemen    Departemen @relation(fields: [departemenId], references: [id], onDelete: Cascade)
  name          String
  role          String
  photoUrl      String?
  identity      String?
  achievements  String?

  @@index([departemenId])
}

model ProgramKerja {
  id            String     @id @default(cuid())
  departemenId  String
  departemen    Departemen @relation(fields: [departemenId], references: [id], onDelete: Cascade)
  name          String
  description   String?

  @@index([departemenId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, action, createdAt(sort: Desc)])
}
