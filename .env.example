# PostgreSQL v18 Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/bem_unand?schema=public"

# Rahasia sesi iron-session (wajib string acak minimal 32 karakter)
# Generate via: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-rahasia-acak-minimal-32-karakter"

# Kredensial Akun Default untuk Seed Awal (Minimal 8 Karakter)
ADMIN_SEED_EMAIL="admin@bemfhunand.com"
ADMIN_SEED_PASSWORD="GantiPasswordAdmin123!"
SUPERUSER_SEED_EMAIL="superuser@bemfhunand.com"
SUPERUSER_SEED_PASSWORD="GantiPasswordSuperuser123!"

